{
  "name": "@adminforth/mcp",
  "version": "1.0.0",
  "description": "Expose AdminForth APIs as an authenticated MCP server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://adminforth.dev/docs/tutorial/Plugins/mcp/",
  "repository": {
    "type": "git",
    "url": "https://github.com/devforth/adminforth-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/devforth/adminforth-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && rsync -av --exclude 'node_modules' custom dist/",
    "test": "rm -rf dist && pnpm build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "adminforth",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "codex",
    "claude",
    "gemini"
  ],
  "author": "DevForth (https://devforth.io)",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "adminforth": "^3.32.0",
    "express": "^5.2.1",
    "semantic-release": "^24.2.1",
    "semantic-release-slack-bot": "^4.0.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "adminforth": "^3.32.0",
    "express": "^4.21.0 || ^5.0.0"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "semantic-release-slack-bot",
        {
          "packageName": "@adminforth/mcp",
          "notifyOnSuccess": true,
          "notifyOnFail": true,
          "slackIcon": ":package:",
          "markdownReleaseNotes": true
        }
      ]
    ],
    "branches": [
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
